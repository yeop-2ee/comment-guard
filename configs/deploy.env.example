# configs/deploy.env 로 복사해서 실제 값을 채우세요. deploy.env는 Git에 올라가지 않습니다.
# 인증은 vercel login(브라우저 인증)으로 합니다. 토큰을 이 파일에 적지 않습니다.
VERCEL_PROJECT=comment-guard
# 개인(Hobby) 계정이면 비워 둡니다. 팀 계정이면 팀 slug
VERCEL_SCOPE=
REGION=icn1
BLOB_STORE=comment-guard-models
# vercel_setup.sh가 저장소를 만든 뒤 채웁니다 (기록에서는 가림)
BLOB_STORE_ID=
# 첫 배포 뒤 vercel_setup.sh 또는 deploy_vercel.sh가 알려 주는 프로덕션 주소 (예: https://comment-guard-xxxx.vercel.app)
PROD_URL=
# Vercel CLI 버전 고정 (npx로 실행)
VERCEL_CLI=vercel@66.6.0
